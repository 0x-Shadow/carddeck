{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app",
    "components",
    "drizzle",
    "lib",
    "next-env.d.ts",
    "src",
    "test",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
