# --- AI provider (optional; app is fully usable with zero keys via StubProvider) ---
# When set, OpenAIProvider activates and real models generate outlines/cards.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint (leave blank for OpenAI's public API).
OPENAI_BASE_URL=

# --- Sessions ---
# >=32 chars; required in production, dev falls back to an insecure default.
SESSION_SECRET=dev-insecure-secret-change-me-0123456789abcdef

# --- Storage ---
# Directory for the SQLite database and generated artifacts.
DATA_DIR=./data

# --- Worker ---
# Queue polling interval in milliseconds.
WORKER_POLL_MS=500
